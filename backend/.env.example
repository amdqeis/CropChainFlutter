# Runtime
PROJECT_NAME=CropChain API
API_V1_STR=/api/v1
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
DOMAIN=api.example.com

# Security: generate unique values with `openssl rand -hex 32`
SECRET_KEY=replace-with-at-least-32-random-characters
KTP_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
DEMO_API_KEY=replace-development-demo-key
OTP_MAX_ATTEMPTS=5

# PostgreSQL / Redis
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-database-password
POSTGRES_DB=cropchain
DATABASE_URL=postgresql+asyncpg://postgres:replace-database-password@localhost:5432/cropchain
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# OTP / SMTP. Without MAIL_USERNAME, development returns dev_otp.
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@cropchain.id
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=CropChain
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Explicit prototype providers
PAYMENT_PROVIDER=fake
SHIPPING_PROVIDER=fake
STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=fake
MAPS_PROVIDER=fake

# Optional sandbox/real adapters (required only when selected above)
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
SHIPPER_API_KEY=
SHIPPER_BASE_URL=https://merchant-api-sandbox.shipper.id
CLOUDINARY_URL=
GOOGLE_MAPS_API_KEY=
FCM_CREDENTIALS_PATH=

# Storage and business rules
UPLOAD_DIR=media
PRIVATE_UPLOAD_DIR=.private_media
MAX_UPLOAD_SIZE_MB=5
PLATFORM_FEE_PERCENTAGE=2.5
CHECKOUT_RESERVATION_MINUTES=15
DISPUTE_WINDOW_DAYS=7
